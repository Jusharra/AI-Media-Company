# Anthropic
ANTHROPIC_API_KEY=

# Retell AI / VAPI
RETELL_API_KEY=
VAPI_API_KEY=

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# X / Twitter API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# SendGrid (async interview emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Admin Auth
SESSION_SECRET=your-super-secret-session-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# App Config
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL (for auth — admin_users, sessions, platform_tokens)
# Get this from https://neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# One-time migration secret (set any random string, hit /api/auth/migrate?secret=... once)
MIGRATE_SECRET=change-me

# Agent SQLite databases (use /tmp/signal-dbs on Netlify so writes succeed)
DB_DIR=./src/agents
